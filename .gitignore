__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# DuckPipe state/output generated by running the examples locally.
# The default state file is literally named `duckpipe.db` (see
# _default_db_path in src/duckpipe/scheduler.py) -- not `*.duckdb` --
# and examples that pass an explicit --db use a `duckpipe.<engine>.db`
# naming convention, so match both broadly rather than one at a time.
duckpipe*.db
duckpipe*.db.wal
*.duckdb
*.duckdb.wal
examples/**/warehouse.duckdb
examples/**/output/
examples/**/report.csv
examples/data/full/
examples/04_distributed_cluster/cluster_bucket/
examples/05_distributed_with_ducklake/catalog.sqlite
examples/05_distributed_with_ducklake/data/
examples/**/*.ducklake.sqlite
examples/**/*.ducklake.sqlite.data/
